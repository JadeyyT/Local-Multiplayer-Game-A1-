      m_Calls: []
  m_text: "<b>\U0001F504 Game Flow</b>  \r\n\u2022 Player 1 starts as attacker  \r\n\u2022
    Attacker: Press Space to Slash  \r\n\u2022 Defender must:  \r\n   \u2013 Dodge
    (\u2190 or \u2192 for Player 2, A or D for Player 1)  \r\n   \u2013 OR Catch
    (Enter for Player 2, Space for Player 1)  \r\n\r\n<b>\U0001F9E9 Outcome</b> 
    \r\n\u2022 If defender gets hit \u2013 they lose 1 life  \r\n\u2022 If defender
    catches \u2013 roles switch instantly  \r\n\u2022 When a player runs out of lives
    \u2013 they die \u2013 the other player wins  \r\n\r\n<b>\U0001F501 Next Round</b> 
    \r\n\u2022 Round continues with reversed roles if catch succeeds  \r\n\u2022
    Game resets when someone runs out of lives  "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
